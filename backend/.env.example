# TPV Moderno — backend. Plantilla de variables de entorno (sin valores reales, ADR-008).
# Copiar a `.env` FUERA del repositorio y generar credenciales nuevas en cada instalación.

# PostgreSQL — solo este proceso accede a la BD (ADR-002). Driver async: postgresql+psycopg://
TPV_DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@localhost:5432/tpv

# Identidad del despliegue y logging
TPV_ENV=dev
TPV_LOG_LEVEL=INFO

# CORS: solo orígenes servidos por el propio servidor (§6), separados por comas
TPV_CORS_ORIGINS=

# Pool de conexiones
TPV_DB_POOL_SIZE=5
TPV_DB_MAX_OVERFLOW=10

# Secreto de firma de los JWT de acceso — OBLIGATORIO para /api/v1/auth.
# Generar nuevo en cada instalación (mínimo 32 caracteres; se recomiendan 64):
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
TPV_JWT_SECRET=

# Vida de los tokens (fase 03): access JWT corto + refresh rotativo y revocable
TPV_ACCESS_TOKEN_MINUTES=15
TPV_REFRESH_TOKEN_HOURS=12

# Anti-abuso en /auth/login y /auth/pin: intentos por IP y ruta dentro de la ventana
TPV_AUTH_RATE_LIMIT_ATTEMPTS=10
TPV_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
