# =============================================================================
# TPV Moderno — variables de despliegue Docker (PLANTILLA, ADR-008).
#
#   1. cp .env.example .env        (el .env NUNCA entra en un repositorio)
#   2. Sustituye los dos valores CAMBIAME por secretos NUEVOS y rotados:
#        python -c "import secrets; print(secrets.token_urlsafe(24))"   # BD
#        python -c "import secrets; print(secrets.token_urlsafe(64))"   # JWT
#   3. docker compose up -d --build
# =============================================================================

# ---- Secretos (OBLIGATORIOS: compose se niega a arrancar sin ellos) ---------
POSTGRES_PASSWORD=CAMBIAME-token_urlsafe-24
TPV_JWT_SECRET=CAMBIAME-token_urlsafe-64-minimo-32-caracteres

# ---- Proxy ------------------------------------------------------------------
# Puerto publicado en el anfitrión (80/443 por defecto).
TPV_HTTP_PORT=80
TPV_HTTPS_PORT=443
# Dominio del MODO B (HTTPS con CA interna). Déjalo comentado en MODO A.
# TPV_DOMAIN=tpv.cafeteria.local

# ---- Aplicación -------------------------------------------------------------
TPV_ENV=prod
TPV_LOG_LEVEL=INFO

# ---- Retención de copias (la aplica backup.sh) ------------------------------
# Borra copias más viejas que N días, pero conserva SIEMPRE al menos las N
# más recientes.
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MIN=10
